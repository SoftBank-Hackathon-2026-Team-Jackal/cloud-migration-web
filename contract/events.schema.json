          "$ref": "#/$defs/phase"
        },
        "type": {
          "const": "analysis.done"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "progress": {
          "type": "number"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/data:analysis.done"
        }
      },
      "required": [
        "seq",
        "at",
        "phase",
        "type",
        "status",
        "data"
      ],
      "additionalProperties": false
    },
    "event:build.check": {
      "type": "object",
      "properties": {
        "seq": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rest.schema.json",
  "title": "REST 요청·응답",
  "$defs": {
    "StartRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "source_provider": {
          "enum": [
            "AWS"
          ]
        },
        "target_provider": {
          "enum": [
            "GCP",
            "ON_PREM"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "GCP",
                "ON_PREM"
              ]
            },
            "profile": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "agent_id": {
              "type": "string"
            },
            "credential_ref": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "profile"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "GITHUB_PUBLIC"
              ]
            },
            "repository_id": {
              "type": "integer",
              "minimum": 1
            },
            "full_name": {
              "type": "string",
              "pattern": "^[^/\\s]+/[^/\\s]+$"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "kind",
            "repository_id",
            "full_name",
            "commit_sha"
          ],
          "additionalProperties": false
        },
        "env_file_ref": {
          "type": "string"
        },
        "scope_id": {
          "type": "string",
          "pattern": "^scope-[a-f0-9]{16}$"
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "StartResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "properties": {
            "workflow_id": {
              "type": "string"
            }
          },
          "required": [
            "workflow_id"
          ]
        }
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "seconds"
            ],
            "additionalProperties": false
          }
        },
        "ai_fixes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "stages",
        "ai_fixes"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "$ref": "events.schema.json#/$defs/snapshotData"
    },
    "ApprovalRequest": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "APPROVE",
            "REJECT"
          ]
        },
        "scope": {
          "enum": [
            "INFRASTRUCTURE",
            "WORKLOADS",
            "FULL"
          ]
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preview_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "decision",
        "scope",
        "manifest_digest",
        "preview_digest"
      ],
      "additionalProperties": false
    },
    "ApprovalResponse": {
      "type": "object",
      "description": "백엔드 openapi ApprovalResponse. 접수(결정)·전달(delivery_status)·실행(execution_status)을 따로 둔다. 전달 실패도 201/200 + FAILED로 온다.",
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "decision": {
          "enum": [
            "APPROVE",
            "REJECT"
          ]
        },
        "approver_id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "INFRASTRUCTURE",
            "WORKLOADS",
            "FULL"
          ]
        },
        "delivery_status": {
          "enum": [
            "PENDING",
            "DELIVERED",
            "FAILED"
          ]
        },
        "delivery_attempts": {
          "type": "integer"
        },
        "execution_status": {
          "enum": [
            "NOT_STARTED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "workflow_state": {
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "plan_id",
        "revision",
        "decision",
        "approver_id",
        "scope",
        "delivery_status",
        "delivery_attempts",
        "execution_status",
        "workflow_state"
      ],
      "additionalProperties": false
    }
  }
}
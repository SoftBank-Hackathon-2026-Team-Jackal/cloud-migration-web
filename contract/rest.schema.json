{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rest.schema.json",
  "title": "REST 요청·응답",
  "$defs": {
    "StartRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "source_provider": {
          "enum": [
            "AWS"
          ]
        },
        "target_provider": {
          "enum": [
            "GCP",
            "ON_PREM"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "GCP",
                "ON_PREM"
              ]
            },
            "profile": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "agent_id": {
              "type": "string"
            },
            "credential_ref": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "profile"
          ],
          "additionalProperties": false
        },
        "env_file_ref": {
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "StartResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "properties": {
            "workflow_id": {
              "type": "string"
            }
          },
          "required": [
            "workflow_id"
          ]
        }
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "seconds"
            ],
            "additionalProperties": false
          }
        },
        "ai_fixes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "stages",
        "ai_fixes"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "$ref": "events.schema.json#/$defs/snapshotData"
    },
    "ApprovalRequest": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "APPROVE",
            "REJECT"
          ]
        },
        "scope": {
          "enum": [
            "INFRASTRUCTURE",
            "WORKLOADS",
            "FULL"
          ]
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preview_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "decision",
        "scope",
        "manifest_digest",
        "preview_digest"
      ],
      "additionalProperties": false
    }
  }
}
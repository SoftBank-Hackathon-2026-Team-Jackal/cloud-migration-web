{
  "name": "cloud-migration-web",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:quick": "npm run typecheck && npm test",
    "mock:server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mock-sse-server.mjs",
    "test:e2e": "node tests/e2e/flow.mjs",
    "test:e2e:merge": "node tests/e2e/run.mjs flow opening",
    "test:e2e:all": "node tests/e2e/run.mjs all",
    "test:e2e:sse": "node tests/e2e/sse-states.mjs",
    "test:e2e:review": "node tests/e2e/review.mjs",
    "test:e2e:agent": "node tests/e2e/agent.mjs",
    "test:e2e:github": "node tests/e2e/github.mjs",
    "test:e2e:voice": "node tests/e2e/voice.mjs",
    "tts:download": "node scripts/download-tts-model.mjs",
    "tts:pregen": "node scripts/pregen-tts.ts",
    "contract:check": "node --test \"tests/unit/contract.test.ts\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "next": "^16.4.4",
    "next-auth": "5.0.0-beta.32",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "ajv": "^8.20.0",
    "typescript": "~5.9.3"
  }
}

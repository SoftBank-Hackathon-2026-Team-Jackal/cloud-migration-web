# 복사해서 .env.local 로 쓰세요(.env*.local 은 git에 올라가지 않습니다). 여기에는 실제 값을 넣지 마세요.

# GitHub 로그인(Auth.js + GitHub OAuth App). 서버 전용 값이며 NEXT_PUBLIC_ 를 붙이지 않습니다.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 세션 JWT 암호화 키: `npx auth secret` 또는 `openssl rand -base64 33`
AUTH_SECRET=

# 데이터 모드: mock(기본) | sse
NEXT_PUBLIC_API_MODE=
NEXT_PUBLIC_API_BASE=
# SSE 시작 방식: wait(기본, 백엔드 연결 대기) | source(platform#60 이후) | legacy(목업 SSE 서버 시험 전용)
NEXT_PUBLIC_SSE_START=
# (선택) SSE 모드에서 켤 동작, 쉼표 구분: sandbox.retry, traffic.rollback, traffic.retry, report.
# 비우면 기본값(src/lib/migration/capabilities.ts, 지금은 모두 꺼짐: 백엔드에 API가 아직 없다). none이면 모두 끔. 목업 모드는 늘 모두 켜짐.
NEXT_PUBLIC_SSE_CAPABILITIES=

# 연결 관리(/settings) — 웹 서버(BFF) 전용 값. NEXT_PUBLIC_ 를 붙이지 않습니다(브라우저 번들에 들어가지 않음).
# 플랫폼 API 주소(데모 서버 컨테이너에서는 http://api:8000). 개발 서버에서만 비우면 http://127.0.0.1:8000
PLATFORM_API_BASE=
# X-Enrollment-Admin-Key 값(연결 관리·Agent 등록 토큰 발급·상태 조회·폐기). 플랫폼 /opt/cmp/.env의 AGENT_ENROLLMENT_ADMIN_KEY와 같은 값.
PLATFORM_ENROLLMENT_ADMIN_KEY=
# 설치 명령의 platform.url — 에이전트가 닿는 플랫폼 공개 HTTPS 주소
PLATFORM_PUBLIC_URL=
# 등록 요청의 owner_id(기본 platform)
PLATFORM_OWNER_ID=
# real | mock. 클라우드 연결(AWS Launch Stack·역할 확인·GCP)과 Agent를 실제 플랫폼 API로 부를지 목업으로 답할지.
# 비우면 프로덕션(next start·컨테이너)은 real, 개발 서버(npm run dev)와 NEXT_PUBLIC_API_MODE=mock 빌드는 mock.
# real에서 PLATFORM_API_BASE·PLATFORM_ENROLLMENT_ADMIN_KEY가 비어 있으면 목업으로 떨어지지 않고 설정 누락 오류(503)를 화면에 보인다.
PLATFORM_CONNECTIONS=
# (선택) 웹 서버를 다시 띄워도 목록에 보일 agent_id, 쉼표 구분([가정] 목록 API가 생기면 필요 없음)
PLATFORM_KNOWN_AGENT_IDS=

# 계획 승인 중계(/api/approvals) — 웹 서버(BFF) 전용 값. NEXT_PUBLIC_ 를 붙이지 않습니다.
# 플랫폼 승인 API(POST /provisioning/plans/…/approvals)의 Authorization: Bearer 승인자 토큰. 브라우저는 이 값을 갖지 않고,
# 웹 서버가 PLATFORM_API_BASE로 중계할 때 붙입니다. 비우면 승인이 503(APPROVER_TOKEN_NOT_CONFIGURED)으로 막힙니다.
# 값이 있으면 승인은 ADMIN_GITHUB_LOGINS에 있는 로그인 계정만 보낼 수 있습니다.
PLATFORM_APPROVER_TOKEN=
# (선택) direct: 브라우저가 NEXT_PUBLIC_API_BASE로 승인을 직접 보냅니다(토큰이 필요 없는 목업 SSE 서버 단독 시험 전용). 기본은 중계.
NEXT_PUBLIC_APPROVAL_RELAY=

# 연결·Agent 관리(/api/connections, /api/agents)를 쓸 수 있는 GitHub 로그인 이름(쉼표 구분).
# 실제 API를 쓰는 서버(운영자 키가 있는 서버)에서는 로그인한 계정이 여기에 있을 때만 통과한다. 비우면 아무도 못 쓴다.
ADMIN_GITHUB_LOGINS=

# Temporal UI 사이드바(늘 켜짐, 읽기 전용): Temporal UI 주소. 비우면 배포(next build)는 http://temporal-ui:8080(compose 같은 네트워크),
# 개발 서버는 http://127.0.0.1:8233(컨트롤 플레인 8080을 SSM 포트 포워딩). rewrite에 쓰이므로 바꾸면 다시 빌드한다.
TEMPORAL_UI_URL=
# 네임스페이스(기본 default)
TEMPORAL_NAMESPACE=

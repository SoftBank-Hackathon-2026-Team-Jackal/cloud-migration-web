# 복사해서 .env.local 로 쓰세요(.env*.local 은 git에 올라가지 않습니다). 여기에는 실제 값을 넣지 마세요.

# GitHub 로그인(Auth.js + GitHub OAuth App). 서버 전용 값이며 NEXT_PUBLIC_ 를 붙이지 않습니다.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 세션 JWT 암호화 키: `npx auth secret` 또는 `openssl rand -base64 33`
AUTH_SECRET=

# 데이터 모드: mock(기본) | sse
NEXT_PUBLIC_API_MODE=
NEXT_PUBLIC_API_BASE=
# SSE 시작 방식: wait(기본, 백엔드 연결 대기) | source(platform#60 이후) | legacy(목업 SSE 서버 시험 전용)
NEXT_PUBLIC_SSE_START=

# 연결 관리(/settings) — 웹 서버(BFF) 전용 값. NEXT_PUBLIC_ 를 붙이지 않습니다(브라우저 번들에 들어가지 않음).
# 플랫폼 API 주소(데모 서버에서는 루프백에만 열려 있다. 기본 http://127.0.0.1:8000)
PLATFORM_API_BASE=
# X-Enrollment-Admin-Key 값(Agent 등록 토큰 발급·상태 조회·폐기). 비우면 목업 모드에서는 Agent도 목업으로 답한다.
PLATFORM_ENROLLMENT_ADMIN_KEY=
# 설치 명령의 platform.url — 에이전트가 닿는 플랫폼 공개 HTTPS 주소
PLATFORM_PUBLIC_URL=
# 등록 요청의 owner_id(기본 platform)
PLATFORM_OWNER_ID=
# (선택) 웹 서버를 다시 띄워도 목록에 보일 agent_id, 쉼표 구분([가정] 목록 API가 생기면 필요 없음)
PLATFORM_KNOWN_AGENT_IDS=
